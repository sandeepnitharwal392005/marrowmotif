# Environment variables — copy to .env and fill in values

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL="postgresql://travel:travel_secret@localhost:5432/travel_platform"

# ============================================================
# REDIS
# ============================================================
REDIS_URL="redis://localhost:6379"

# ============================================================
# JWT
# ============================================================
JWT_SECRET="change-me-super-secret-jwt-key-32chars+"
JWT_REFRESH_SECRET="change-me-refresh-secret-key-32chars+"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================================
# DEMO MODE — set to true only in an isolated demo environment
# ============================================================
DEMO_MODE=false

# ============================================================
# WHATSAPP (only needed when DEMO_MODE=false)
# ============================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_NUMBER=

# ============================================================
# GOOGLE DRIVE (only needed when DEMO_MODE=false)
# ============================================================
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ============================================================
# S3-COMPATIBLE STORAGE (only needed when DEMO_MODE=false)
# ============================================================
S3_ENDPOINT=
S3_BUCKET=travel-products
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ============================================================
# API
# ============================================================
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ============================================================
# FRONTEND
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_MODE=false
# Only set this in a demo frontend build. Never put production credentials here.
NEXT_PUBLIC_DEMO_LOGIN_HINT=
